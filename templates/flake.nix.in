# Generated by the unofficial graphical installer with Determinate Nix.
# flake.lock records the same tested revisions as the installation media.
# Update everything with `nix flake update`, or only the installer's desktop,
# tuning and application modules with `nix flake update calamares`; then run
# `nixos-rebuild boot --flake /etc/nixos`.
{
  inputs.nixpkgs.url = "https://flakehub.com/f/NixOS/nixpkgs/0.1";
  inputs.determinate.url = "https://flakehub.com/f/DeterminateSystems/determinate/*";
  inputs.fh.url = "https://flakehub.com/f/DeterminateSystems/fh/*.tar.gz";
  inputs.applications.url = "github:NixOS/nixpkgs/nixos-unstable";
  inputs.ai-apps.url = "github:numtide/llm-agents.nix";
  inputs.omp.url = "github:can1357/oh-my-pi/v18.6.1";
  inputs.calamares.url = "github:bitemyapp/calamares/stable";
  inputs.calamares.inputs.nixpkgs.follows = "nixpkgs";

  outputs = { nixpkgs, determinate, fh, applications, ai-apps, omp, calamares, ... }: {
    nixosConfigurations.@HOSTNAME@ = nixpkgs.lib.nixosSystem {
      system = "x86_64-linux";
      specialArgs = {
        applicationPkgs = import applications {
          system = "x86_64-linux";
          config.allowUnfree = true;
        };
        aiPackages = ai-apps.packages.x86_64-linux;
        ompPackage = omp.packages.x86_64-linux.omp;
      };
      modules = [
        determinate.nixosModules.default
        calamares.nixosModules.default
        ./configuration.nix
        ({ pkgs, ... }: {
          environment.systemPackages = [ fh.packages.${pkgs.stdenv.hostPlatform.system}.default ];
        })
      ];
    };
  };
}
